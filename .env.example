# Copie ce fichier en .env.local pour lancer en local. En ligne, ces valeurs se règlent dans
# Vercel → Settings → Environment Variables. Ne mets JAMAIS ces valeurs dans le code.
# Sans les trois variables Supabase, l'app démarre en mode démo (données fictives).

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Chiffrement des clés des espaces (facultatif) ---
# 32 octets en base64 : openssl rand -base64 32. Sans elle, clé dérivée de SUPABASE_SECRET_KEY.
ENCRYPTION_KEY=

# Les clés Meta, TrendTrack et Anthropic se saisissent DANS l'application (Réglages →
# Connexions), une fois par espace. Elles ne vont pas ici.
META_GRAPH_VERSION=v26.0
META_STALE_MINUTES=10
TRENDTRACK_ROWS=15
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- P&L Google Sheets (compte de service en lecture seule) ---
# Colle le JSON du compte de service sur UNE seule ligne.
GOOGLE_SERVICE_ACCOUNT_JSON=
PNL_SHEET_NAME=DAILY REPORT

# --- Tâche du matin (Vercel Cron) : une longue chaîne aléatoire ---
CRON_SECRET=
