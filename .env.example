# Copie ce fichier en .env.local pour lancer en local. En ligne, ces valeurs se règlent dans
# Vercel → Settings → Environment Variables. Ne mets JAMAIS ces valeurs dans le code.
# Sans les trois variables Supabase, l'app démarre en mode démo (données fictives).

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Meta Ads : jeton d'utilisateur système, permission ads_read uniquement ---
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0
# Âge maximum des données Meta avant resynchronisation à l'ouverture d'une page (minutes)
META_STALE_MINUTES=10

# --- TrendTrack (app.trendtrack.io → Workspace settings → API) ---
TRENDTRACK_API_KEY=
# Lignes par appel : ~3 × cette valeur crédits par concurrent et par relevé
TRENDTRACK_ROWS=15

# --- Anthropic (console.anthropic.com → API keys) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- P&L Google Sheets (compte de service en lecture seule) ---
# Colle le JSON du compte de service sur UNE seule ligne.
GOOGLE_SERVICE_ACCOUNT_JSON=
PNL_SPREADSHEET_ID=
PNL_SHEET_NAME=DAILY REPORT

# --- Tâche du matin (Vercel Cron) : une longue chaîne aléatoire ---
CRON_SECRET=
